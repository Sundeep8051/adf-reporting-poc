{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-poc-demo"
		},
		"ls_ablob_reportingsa_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_ablob_reportingsa'"
		},
		"ls_adls_reportingdl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_reportingdl'"
		},
		"ls_adls_reportingdl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://reportingdtlakegen2.dfs.core.windows.net/"
		},
		"storage_event_trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/2213e8b1-dbc7-4d54-8aff-b5e315df5e5b/resourceGroups/1-493968e5-playground-sandbox/providers/Microsoft.Storage/storageAccounts/reportingsa2025"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-poc-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_reportingsa_connectionString": {
						"value": "[parameters('ls_ablob_reportingsa_connectionString')]"
					},
					"ls_adls_reportingdl_accountKey": {
						"value": "[parameters('ls_adls_reportingdl_accountKey')]"
					},
					"ls_adls_reportingdl_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_reportingdl_properties_typeProperties_url')]"
					},
					"storage_event_trigger_properties_typeProperties_scope": {
						"value": "[parameters('storage_event_trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}